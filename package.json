{
  "name": "deepseek-fastify-api",
  "version": "1.0.0",
  "description": "Fastify OpenAI-compatible gateway over the deepseek-free-api engine using browser-captured DeepSeek tokens from env",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "postinstall": "cd engine && npm install --omit=dev"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/env": "^5.0.0",
    "dotenv": "^16.4.5"
  }
}