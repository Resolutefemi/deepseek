# Browser-captured DeepSeek user token(s) from https://chat.deepseek.com
# F12 -> Application -> LocalStorage -> userToken -> value
# Comma-separate multiple accounts for load balancing (each runs one stream at a time).
DEEP_SEEK_CHAT_AUTHORIZATION=

# Upstream deepseek-free-api engine host/port.
DEEPSEEK_UPSTREAM_HOST=127.0.0.1
DEEPSEEK_UPSTREAM_PORT=8000

# Auto-launch the upstream engine on this Fastify gateway boot.
AUTO_LAUNCH_UPSTREAM=true

# Fastify gateway listen host/port.
HOST=0.0.0.0
PORT=3000

# Optional session reuse toggles (mirror the engine's .env options).
# CHAT_SESSION_REUSE=true
# RESPONSES_SESSION_REUSE=true
# ANTHROPIC_SESSION_REUSE=true